/target
/web/node_modules
/web/dist
# Tauri build output: the capability manifest and platform schemas are
# regenerated by desktop/build.rs, so committing them only invites drift
# between the checked-in copy and what the binary actually enforces.
/desktop/gen
/data
# docker compose bind mounts
/yunova_data
/yunova_mysql
/yunova_postgres
# legacy layout
/yunova.db
/yunova.db-*
/yunova.toml
# Existing installations may still use the original data/configuration paths.
/novachat_data
/novachat_mysql
/novachat_postgres
/novachat.db
/novachat.db-*
/novachat.toml
# Personal Claude Code overrides
/.claude/settings.local.json

# Python bytecode (sneaks in via .claude/skills/.../scripts/)
__pycache__/
*.pyc
